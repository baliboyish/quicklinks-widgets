<?xml version="1.0" encoding="utf-8"?>
<!-- Floating slider panel (a real Activity, so the SeekBar can be dragged
     for real). Shown when a bar in the widget is tapped. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/slider_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp">

    <LinearLayout
        android:id="@+id/slider_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/panel_bg"
        android:clickable="true"
        android:padding="20dp">

        <TextView
            android:id="@+id/slider_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volume"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/slider_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="50%"
            android:textColor="#9CA3AF"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/slider_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:max="100" />
    </LinearLayout>
</LinearLayout>
