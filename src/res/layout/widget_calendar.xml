                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center" android:text="Flashlight" android:textColor="#E5E7EB" android:textSize="9sp" />
                    </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/row_volume" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
