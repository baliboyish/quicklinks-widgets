<?xml version="1.0" encoding="utf-8"?>
<!-- Beauty Calendar widget layout. Built with the same "safe" rules as the
     working AI Assistant widget: LinearLayout/TextView/ImageView only,
     all backgrounds are drawable files, no shorthand margins, no maxLines.
     ProgressBar is on the AppWidget allowed-views list. Day cell ids run
     day_0..day_41 (Mon-first) with a dot_0..dot_41 event dot under each. -->
