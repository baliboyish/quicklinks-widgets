                <ProgressBar android:id="@+id/bar_ring" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:layout_marginLeft="8dp" android:max="100" android:progress="50" android:progressDrawable="@drawable/pb_ring" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Tap a bar for the drag slider" android:textColor="#6B7280" android:textSize="8sp" />
