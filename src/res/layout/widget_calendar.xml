                <ProgressBar android:id="@+id/bar_volume" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1" android:layout_marginLeft="8dp" android:max="100" android:progress="50" android:progressDrawable="@drawable/pb_media" />
